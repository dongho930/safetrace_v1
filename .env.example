# 복사해서 .env 로 쓰고 값을 채운다. .env 는 커밋하지 않는다(.gitignore).
# 난수 생성: python -c "import secrets;print(secrets.token_hex(32))"

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 증거 HMAC 서명 키(32바이트 이상). 에이전트(서명)·API(검증)만 사용. DB·증거 볼륨에 저장하지 않는다.
ST_EVIDENCE_HMAC_KEY=
ST_EVIDENCE_KEY_ID=k1

# 에이전트 → 판단 서비스 내부 인증 토큰
ST_DECISION_TOKEN=

# Jev (판단 서비스만 사용). 둘 다 비우면 규칙 기반 판단기로만 동작.
ST_TYPESAFE_API_KEY=
ST_OPENROUTER_API_KEY=
ST_JEV_MODEL=jev-1.13.0
ST_OPENROUTER_JEV_MODEL=typesafe/jev-1.13
ST_DECIDER_CHAIN=["jev_typesafe","jev_openrouter","rules"]

# Google Safe Browsing v4 (선택)
ST_SAFEBROWSING_API_KEY=

# 자동화(스크립트)용 API 토큰: "토큰:역할" (viewer | investigator | reviewer | admin). 토큰은 24자 이상.
# 담당자는 계정으로 로그인한다: docker compose exec api python -m safetrace.accounts add <아이디> --role admin
ST_API_TOKENS=[]
ST_CORS_ORIGINS=["http://localhost:8080"]

# 시연용 시험 페이지 허용(운영에서는 비움). 예: ["testpages:8900","testpages-alt:8900"] / 프록시는 쉼표 구분: testpages:8900,testpages-alt:8900
ST_TEST_ALLOWLIST=[]
ST_EGRESS_TEST_ALLOWLIST=

# 웹 콘솔 호스트 포트(8080 이 이미 쓰이면 바꾼다. CORS 도 같이 바꾼다)
ST_WEB_PORT=8080
